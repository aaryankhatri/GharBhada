# Postgres (Supabase) — pooled (app) + direct (migrations) connection strings
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
JWT_SECRET="your-long-random-secret"
PORT=4000
CLIENT_URL="http://localhost:5173"

# Cloud storage (Supabase Storage) — production photo/document uploads.
# Same Supabase project as DATABASE_URL above. Find these under Project Settings → API.
# Leave unset for local dev — uploads fall back to server/uploads/ on disk automatically.
# After setting these, run once: npm run setup-storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

